# ========================================================
# ReachInbox Email Scheduler - Master Environment Configuration
# ========================================================

# Application Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
JWT_SECRET=super-secret-jwt-key-reachinbox-2025

# Database (PostgreSQL via Docker or local)
DATABASE_URL=postgresql://reachinbox:reachinbox_password@localhost:5432/reachinbox_db?schema=public

# Redis (for BullMQ queues, rate limiting, and locks)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch (for high-speed email search & indexing)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# Scheduler & Concurrency Controls
# Worker concurrency (number of parallel jobs processed simultaneously)
WORKER_CONCURRENCY=5
# Minimum delay between two consecutive emails in seconds (provider throttling mimic)
DEFAULT_DELAY_BETWEEN_EMAILS=2
# Max emails allowed per sender per 1-hour rolling window
MAX_EMAILS_PER_HOUR_PER_SENDER=100

# Ethereal Email (Fake SMTP for testing)
# If left empty, the backend automatically generates a dynamic Ethereal test account on first run!
ETHEREAL_USER=
ETHEREAL_PASS=

# Google OAuth Credentials (for frontend/backend Google Login)
# Set your real Google Client ID & Secret from Google Cloud Console:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Slack Integration (for live rate-limit alert notifications)
# Option A: Incoming Webhook URL (instant notifications without OAuth)
SLACK_WEBHOOK_URL=
# Option B: Slack OAuth App Credentials (for "Connect Slack" OAuth flow)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/oauth/callback
