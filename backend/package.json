{
  "name": "reachinbox-scheduler-backend",
  "version": "1.0.0",
  "description": "Production-grade Email Scheduler Backend with BullMQ, Redis, PostgreSQL, Elasticsearch & Ethereal",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:sync": "node scripts/sync-db-provider.js",
    "prisma:generate": "node scripts/sync-db-provider.js && prisma generate",
    "prisma:migrate": "node scripts/sync-db-provider.js && prisma migrate dev",
    "prisma:push": "node scripts/sync-db-provider.js && prisma db push"
  },
  "dependencies": {
    "@bull-board/api": "^6.8.0",
    "@bull-board/express": "^6.8.0",
    "@elastic/elasticsearch": "^8.13.1",
    "@prisma/client": "^6.4.1",
    "@slack/web-api": "^7.8.0",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^9.15.1",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.5",
    "@types/nodemailer": "^6.4.17",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
